{
  "name": "batch",
  "private": true,
  "version": "0.1.0",
  "description": "Batch conditional commerce app",
  "scripts": {
    "dev": "pnpm --filter @batch/web dev",
    "build": "pnpm --filter @batch/web build",
    "start": "pnpm --filter @batch/web start",
    "lint": "pnpm --filter @batch/web lint",
    "typecheck": "pnpm --filter @batch/web typecheck && pnpm --filter @batch/core typecheck && pnpm --filter @batch/payments typecheck",
    "test": "pnpm --filter @batch/core test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "core:typecheck": "pnpm --filter @batch/core typecheck",
    "payments:typecheck": "pnpm --filter @batch/payments typecheck",
    "db:generate": "pnpm --filter @batch/db prisma:generate",
    "db:migrate": "pnpm --filter @batch/db prisma:migrate",
    "db:studio": "pnpm --filter @batch/db prisma:studio",
    "docs": "echo \"Read docs/ and AGENTS.md\""
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0"
}
