{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@batch/core": ["../../packages/core/src/index.ts"],
      "@batch/core/*": ["../../packages/core/src/*"],
      "@batch/db": ["../../packages/db/src/index.ts"],
      "@batch/db/*": ["../../packages/db/src/*"],
      "@batch/payments": ["../../packages/payments/src/index.ts"],
      "@batch/payments/*": ["../../packages/payments/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
