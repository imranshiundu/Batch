          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/operator/disputes", "host": ["{{baseUrl}}"], "path": ["api", "operator", "disputes"] }
          }
        },
        {
          "name": "Open/Update Dispute",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchId\": \"school-uniform-batch\",\n  \"reason\": \"Quality issue reported\",\n  \"action\": \"HOLD_FUNDS\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/operator/disputes", "host": ["{{baseUrl}}"], "path": ["api", "operator", "disputes"] }
          }
        },
        {
          "name": "Transition Batch State",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toStatus\": \"FUNDED\",\n  \"reason\": \"Minimum threshold reached\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/operator/batches/shenzhen-charger-restock/transition", "host": ["{{baseUrl}}"], "path": ["api", "operator", "batches", "shenzhen-charger-restock", "transition"] }
          }
        },
        {
          "name": "Allocate Deliveries",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courier\": \"demo_logistics\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/operator/batches/shenzhen-charger-restock/allocate-deliveries", "host": ["{{baseUrl}}"], "path": ["api", "operator", "batches", "shenzhen-charger-restock", "allocate-deliveries"] }
          }
        },
        {
          "name": "Issue Refund",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Batch cancelled due to supplier failure\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/operator/commitments/cmt_123456/refund", "host": ["{{baseUrl}}"], "path": ["api", "operator", "commitments", "cmt_123456", "refund"] }
          }
        },
        {
          "name": "Approve Milestone Payout",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000,\n  \"currency\": \"USD\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/operator/milestones/ms_001/approve-payout", "host": ["{{baseUrl}}"], "path": ["api", "operator", "milestones", "ms_001", "approve-payout"] }
          }
        }
      ]
