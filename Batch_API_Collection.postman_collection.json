    {
      "name": "Payments",
      "item": [
        {
          "name": "Payment Webhook Endpoint",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment_success\",\n  \"payload\": {\n    \"paymentId\": \"pi_1234\",\n    \"status\": \"completed\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/payments/webhooks/circle", "host": ["{{baseUrl}}"], "path": ["api", "payments", "webhooks", "circle"] }
